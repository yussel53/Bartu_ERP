    "sourceType": 1,
    "sql": "SELECT\n  LTRIM(RTRIM(sto_kod)) AS Code,\n  LTRIM(RTRIM(sto_isim)) AS Title,\n  N'1' AS ProductType,\n  CASE WHEN ISNULL(sto_pasif_fl, 0) = 0 THEN N'Evet' ELSE N'Hayır' END AS IsActive,\n  N'Adet' AS DefaultUnitID\nFROM dbo.STOKLAR WITH (NOLOCK)\nWHERE sto_kod IS NOT NULL\n  AND LTRIM(RTRIM(sto_kod)) <> N''\nORDER BY sto_kod",
